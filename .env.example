# Shared Supabase configuration. Use the publishable key only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Legacy aliases also supported by the app:
# Never commit real keys. Never expose Supabase service-role keys to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Fact Check Tools Claim Search API key (server-side only).
# When unset, the API returns "External fact-check search is not configured."
GOOGLE_FACTCHECK_API_KEY=

# Optional alternate fact-check endpoint that accepts ?query=
FACTCHECK_API_URL=
