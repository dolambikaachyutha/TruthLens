# TruthLens — Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit real keys. NEVER use NEXT_PUBLIC_ for secret keys.

# ── Supabase (required) ──────────────────────────────────────────────────────
# The shared Supabase project URL (same for all environments).
NEXT_PUBLIC_SUPABASE_URL=https://fcdttuocatzgalypwlrt.supabase.co

# The anon / publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zL4Rpz9nmgZ25pcPgWOU1Q_98oUxHm5
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zL4Rpz9nmgZ25pcPgWOU1Q_98oUxHm5

# Legacy aliases supported by the server adapter (same values as above).
SUPABASE_URL=https://fcdttuocatzgalypwlrt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_zL4Rpz9nmgZ25pcPgWOU1Q_98oUxHm5

# The JWKS URL for JWT verification (server-side only).
SUPABASE_JWKS_URL=https://fcdttuocatzgalypwlrt.supabase.co/auth/v1/.well-known/jwks.json

# Server-only secret key for controlled claim mutations (soft delete, upsert).
# NEVER expose this with NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-secret-service-role-key

# ── Optional: Fact-check APIs ─────────────────────────────────────────────────
# Google Fact Check Tools Claim Search API key (server-side only).
# When unset, external fact-check search returns "not configured".
# GOOGLE_FACTCHECK_API_KEY=your_key_here

# Custom fact-check endpoint (alternative to Google).
# FACTCHECK_API_URL=https://your-endpoint.example.com/search
